{
  "name": "careerlog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write \"dist/**/*.{js,html,css}\" \"tests/*.mjs\" \"scripts/*.mjs\" server.mjs package.json README.md \"docs/*.md\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"dist/**/*.{js,html,css}\" \"tests/*.mjs\" \"scripts/*.mjs\" server.mjs package.json README.md \"docs/*.md\" \".github/workflows/*.yml\""
  },
  "devDependencies": {
    "linkedom": "0.18.14",
    "prettier": "3.6.2"
  }
}
